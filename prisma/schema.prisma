generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// =====================================
// スキーリゾート関連
// =====================================

model SkiResort {
  id        String   @id // e.g., "able-hakuba-goryu"
  nameJa    String
  nameEn    String
  shortName String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Location
  prefecture String
  town       String
  latitude   Float
  longitude  Float

  // Course summary
  topElevation               Int
  baseElevation              Int
  verticalDrop               Int
  numberOfCourses            Int
  longestCourse              Int
  steepestSlope              Int?
  beginnersCoursesPercent    Int
  intermediateCoursesPercent Int
  advancedCoursesPercent     Int
  courseImages               String[]

  // Course type (from Gelende)
  typeNotPressed Int?
  typePressed    Int?
  typeBump       Int?
  angleMax       Int?
  angleAvg       Int?

  // Lift summary
  numberOfLifts Int
  ropeways      Int
  gondolas      Int
  quadLifts     Int
  tripleLifts   Int
  pairLifts     Int
  singleLifts   Int
  otherLifts    Int
  liftCapacity  Int?

  // Times
  weekdayOpen  String?
  weekdayClose String?
  weekendOpen  String?
  weekendClose String?
  timesComment String?

  // Others
  website             String?
  skiersPercent       Int?
  snowboardersPercent Int?
  sources             String[]

  // Outline (from Gelende)
  descriptionShort String?
  descriptionLong  String?
  outlineImages    String[]
  condition        String?
  status           String?
  review           Float?

  yukiMagiId String?
  yukiMagi   YukiMagi? @relation(fields: [yukiMagiId], references: [id])

  // Relations
  courses             Course[]
  lifts               Lift[]
  tickets             Ticket[]
  weathers            Weather[]
  forecasts           Forecast[]
  snowDepths          SnowDepthRecord[]
  snowFalls           SnowFallRecord[]
  latestReports       LatestReport[]
  crawlLatestRuns     CrawlLatestRun[]
  crawlLatestCurrents CrawlLatestCurrent[]

  @@map("ski_resorts")
}

model Course {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  name        String
  snowboard   String? // "○", "×", etc.
  difficulty  String? // "初級", "中級", "上級", etc.
  distance    Int? // meters
  angle       Int? // degrees
  note        String?

  @@map("courses")
}

model Lift {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  name        String
  type        String? // "クワッド", "ペア", "ゴンドラ", etc.
  distance    Int? // meters
  hood        String? // "○", "×"

  @@map("lifts")
}

model Ticket {
  id              String    @id @default(cuid())
  skiResortId     String
  skiResort       SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  name            String
  priceAdult      Int?
  priceChild      Int?
  priceOlderChild Int?
  priceSenior     Int?

  @@map("tickets")
}

// =====================================
// 気象データ関連
// =====================================

model Weather {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  date        DateTime
  source      String?

  // Top/Mid/Bot データは JSON として保存（複雑なネスト構造のため）
  topData Json?
  midData Json?
  botData Json?

  createdAt DateTime @default(now())

  @@unique([skiResortId, date])
  @@map("weathers")
}

model Forecast {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  dateStart   String?
  dateEnd     String?

  // Top/Middle/Bottom データは JSON として保存
  topData    Json?
  middleData Json?
  bottomData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skiResortId])
  @@map("forecasts")
}

model SnowDepthRecord {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  date        DateTime
  depth       Int // cm

  @@unique([skiResortId, date])
  @@map("snow_depth_records")
}

model SnowFallRecord {
  id          String    @id @default(cuid())
  skiResortId String
  skiResort   SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  date        DateTime
  snowfall    Int // cm

  @@unique([skiResortId, date])
  @@map("snow_fall_records")
}

model LatestReport {
  id            String    @id @default(cuid())
  skiResortId   String    @unique
  skiResort     SkiResort @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  datetime      DateTime
  snowfall      Int?
  tempBase      Float?
  tempTop       Float?
  overview      String?
  precipitation String?
  wind          String?
  visibility    String?

  createdAt DateTime @default(now())

  @@map("latest_reports")
}

// =====================================
// アメダス・雪マジ（スキー場に紐付かないデータ）
// =====================================

model AmedasData {
  id        String   @id @default(cuid())
  code      Int
  latitude  Float
  longitude Float
  type      String // "snowd", "snowf03h", etc.
  value     Float
  fetchedAt DateTime @default(now())

  @@map("amedas_data")
}

model YukiMagi {
  id   String  @id @default(cuid())
  name String  @unique
  url  String?
  tag  String?

  benefit       String?
  period        String?
  exclusionDate String?

  updatedAt DateTime @updatedAt

  skiResorts SkiResort[]

  @@map("yuki_magi")
}

// =====================================
// 認証（Auth.js v5）
// =====================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("viewer") // "viewer" | "admin"
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// =====================================
// クローリングログ
// =====================================

model CrawlLog {
  id          String   @id @default(cuid())
  crawlerName String   @unique // "skiAreas", "snowDepths", etc.
  lastRunAt   DateTime
  status      String   @default("success") // "success", "failed"
  message     String?

  @@map("crawl_logs")
}

// =====================================
// 公式サイトの最新営業状況
// =====================================

enum CrawlLatestSourceMode {
  LIVE
  WAYBACK_VALIDATION
  LEGACY_IMPORT
}

enum CrawlLatestRunOutcome {
  SUCCESS
  PARTIAL
  FAILED
}

enum CrawlLatestCategoryKind {
  COMMENT
  WEATHER
  COURSES
  LIFTS
}

enum CrawlLatestCategoryState {
  SUCCESS
  EMPTY
  NOT_SUPPORTED
  FAILED
}

enum CrawlLatestValidationState {
  VALID
  WARNING
  INVALID
}

enum CrawlLatestIssueSeverity {
  WARNING
  ERROR
}

enum CrawlLatestArtifactKind {
  RENDERED_DOM
}

enum CrawlLatestArtifactState {
  AVAILABLE
  FAILED
}

model CrawlLatestRun {
  id                String                @id @default(cuid())
  producerId        String                @db.VarChar(100)
  idempotencyKey    String                @db.VarChar(128)
  skiResortId       String?
  skiResort         SkiResort?            @relation(fields: [skiResortId], references: [id], onDelete: Restrict)
  observedAt        DateTime              @db.Timestamptz(3)
  completedAt       DateTime              @db.Timestamptz(3)
  sourceMode        CrawlLatestSourceMode @default(LIVE)
  archiveTimestamp  String?               @db.VarChar(14)
  schemaVersion     Int
  crawlerFile       String?               @db.VarChar(500)
  crawlerRevision   String?               @db.VarChar(128)
  crawlerSourceHash String?               @db.Char(64)
  rawPayload        Json
  requestHash       String                @db.Char(64)
  outcome           CrawlLatestRunOutcome
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  categories CrawlLatestCategorySnapshot[]
  issues     CrawlLatestIssue[]
  artifacts  CrawlLatestArtifact[]

  @@unique([producerId, idempotencyKey])
  @@unique([id, skiResortId])
  @@index([skiResortId, observedAt])
  @@index([sourceMode, observedAt])
  @@map("crawl_latest_runs")
}

model CrawlLatestCategorySnapshot {
  id                 String                     @id @default(cuid())
  runId              String
  skiResortId        String
  run                CrawlLatestRun             @relation(fields: [runId, skiResortId], references: [id, skiResortId], onDelete: Cascade)
  kind               CrawlLatestCategoryKind
  state              CrawlLatestCategoryState
  validationState    CrawlLatestValidationState
  eligibleForCurrent Boolean
  data               Json?
  sourceUrls         String[]
  itemCount          Int
  usableItemCount    Int
  contentHash        String?                    @db.Char(64)
  nameSetHash        String?                    @db.Char(64)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(3)

  current CrawlLatestCurrent?

  @@unique([runId, kind])
  @@unique([id, skiResortId, kind])
  @@index([skiResortId, kind, eligibleForCurrent, createdAt])
  @@map("crawl_latest_category_snapshots")
}

model CrawlLatestCurrent {
  skiResortId String
  skiResort   SkiResort                   @relation(fields: [skiResortId], references: [id], onDelete: Cascade)
  kind        CrawlLatestCategoryKind
  snapshotId  String                      @unique
  snapshot    CrawlLatestCategorySnapshot @relation(fields: [snapshotId, skiResortId, kind], references: [id, skiResortId, kind], onDelete: NoAction)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)

  @@id([skiResortId, kind])
  @@unique([snapshotId, skiResortId, kind])
  @@map("crawl_latest_currents")
}

model CrawlLatestIssue {
  id              String                   @id @default(cuid())
  runId           String
  run             CrawlLatestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  externalId      String?                  @db.VarChar(128)
  categoryKind    CrawlLatestCategoryKind?
  severity        CrawlLatestIssueSeverity
  code            String                   @db.VarChar(100)
  message         String                   @db.Text
  occurrences     Int                      @default(1)
  firstOccurredAt DateTime?                @db.Timestamptz(3)
  lastOccurredAt  DateTime?                @db.Timestamptz(3)
  blocksPromotion Boolean                  @default(false)
  details         Json?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([runId, externalId])
  @@index([runId, severity])
  @@map("crawl_latest_issues")
}

model CrawlLatestArtifact {
  id               String                   @id @default(cuid())
  runId            String
  run              CrawlLatestRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  categoryKind     CrawlLatestCategoryKind?
  kind             CrawlLatestArtifactKind
  state            CrawlLatestArtifactState
  pageKey          String                   @db.VarChar(255)
  title            String?                  @db.Text
  requestedUrl     String?                  @db.Text
  finalUrl         String?                  @db.Text
  httpStatus       Int?
  storageKey       String?                  @db.Text
  sha256           String?                  @db.Char(64)
  sizeBytes        BigInt?
  contentType      String?                  @db.VarChar(255)
  contentEncoding  String?                  @db.VarChar(100)
  captureError     String?                  @db.Text
  redactionVersion Int
  issueExternalIds String[]
  capturedAt       DateTime                 @db.Timestamptz(3)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([runId, pageKey])
  @@unique([runId, storageKey])
  @@index([runId, kind])
  @@map("crawl_latest_artifacts")
}

// =====================================
// 管理画面で編集するJSON / GeoJSON
// =====================================

model DataDocument {
  key       String   @id @db.VarChar(1024)
  content   String   @db.Text
  mediaType String   @db.VarChar(255)
  hash      String   @db.Char(64)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@map("data_documents")
}

// Explicit, transactional one-time imports. Keep these markers when documents
// are edited/deleted; a later deployment must never recreate fixture data.
model CanonicalDataMigration {
  key         String   @id @db.VarChar(200)
  sourceHash  String   @db.Char(64)
  details     Json
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("canonical_data_migrations")
}
