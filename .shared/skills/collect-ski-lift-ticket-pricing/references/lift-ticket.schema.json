{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusutsu.local/schemas/lift-ticket.schema.json",
  "title": "Ski Lift Ticket Pricing (1 resort x 1 season)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "resort",
    "season",
    "sources",
    "geographic_areas",
    "audiences",
    "calendars",
    "operating_hours",
    "areas",
    "products",
    "channels",
    "offers",
    "party_rules",
    "fees",
    "calculation_policy",
    "data_quality"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "resort": {
      "description": "スキー場。名称・都道府県・公式サイトURLは SkiResort マスタが正本なので持たない（二重管理を避ける）。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "SkiResort.id と同じ値。ディレクトリ名とも一致する。"
        }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label_ja",
        "source_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label_ja": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "end_date": {
          "$ref": "#/$defs/nullableDate"
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "description": "このシーズンだと判断した根拠（保存資料のID）。「この料金がいつのものか」は最も重要な前提なので、他の確定情報と同様に証拠を必須にする。",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "geographic_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/geographicArea"
      }
    },
    "audiences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audience"
      }
    },
    "calendars": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calendar"
      }
    },
    "operating_hours": {
      "description": "その日の営業時間・ナイターの有無・定休日。1日券が何時間滑れるかの算出にも使う",
      "type": "array",
      "items": {
        "$ref": "#/$defs/operatingHours"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skiArea"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    },
    "party_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/partyRule"
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fee"
      }
    },
    "calculation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "enum": [
            "JPY"
          ]
        },
        "tax_included": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "stacking_default": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "stackable",
            "not_stackable",
            "unknown",
            null
          ],
          "description": "他割引との併用可否の既定値。語彙は taxonomy の stacking_modes に統一。"
        },
        "best_price_hint_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unresolved_questions",
        "illegible_items"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "generated_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "last_verified_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question_ja"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "question_ja": {
                "type": "string",
                "minLength": 1
              },
              "related_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source_refs": {
                "$ref": "#/$defs/sourceRefs"
              }
            }
          }
        },
        "illegible_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description_ja",
              "source_refs"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "description_ja": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "$ref": "#/$defs/sourceRefs"
              },
              "related_offer_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "human_review_required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_\\-.]*$",
      "minLength": 1,
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableDate": {
      "anyOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableDateTime": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeOfDay": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "nonNegativeAmount": {
      "type": "integer",
      "minimum": 0
    },
    "nullableAmount": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonNegativeAmount"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/nullableDate"
        },
        "end": {
          "$ref": "#/$defs/nullableDate"
        },
        "start_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeOfDay"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeOfDay"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nullablePeriod": {
      "anyOf": [
        {
          "$ref": "#/$defs/period"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "url"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "html",
            "pdf",
            "image",
            "api_response",
            "screenshot",
            "text",
            "unknown"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "requested_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "http_status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "captured_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked_from_source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_specified": {
          "type": "boolean"
        },
        "capture_success": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reading_confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "geographicArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ja",
        "level"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_ja": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "country",
            "prefecture",
            "subprefecture",
            "municipality",
            "district",
            "region_group",
            "unknown"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "member_area_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ja"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_ja": {
          "type": "string",
          "minLength": 1
        },
        "official_label_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "age_max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "age_basis_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "school_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "preschool",
              "elementary_school",
              "junior_high_school",
              "high_school",
              "university",
              "graduate",
              "unknown"
            ]
          },
          "description": "該当する学校区分をすべて列挙する。「小学生以下」なら [\"preschool\",\"elementary_school\"]。「中学生以上」のように学校区分で上限を切れないものは is_default: true で表す。"
        },
        "allow_age_overlap": {
          "type": "boolean"
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "is_default": {
          "description": "他のどのaudienceの条件にも当てはまらなかった場合に適用される区分（多くのスキー場の「大人」）。1スキー場につきちょうど1件。",
          "type": "boolean"
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ja"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_ja": {
          "type": "string",
          "minLength": 1
        },
        "official_label_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "day_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "weekday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday",
              "public_holiday",
              "year_end_new_year",
              "special",
              "all",
              "unknown"
            ]
          }
        },
        "dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        },
        "date_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "$ref": "#/$defs/date"
              },
              "end": {
                "$ref": "#/$defs/date"
              }
            }
          }
        },
        "excluded_dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "description": "日付集合。day_types（曜日・祝日等）/ dates（明示日）/ date_ranges（期間）/ excluded_dates（除外日）の組み合わせで表す。優先度は dates > date_ranges > day_types。かつて calendar_type という分類フィールドがあったが、中身から導出でき、しかも実データで構造が同一なのに別ラベルが付くなど恣意的だったため廃止した。"
    },
    "skiArea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ja"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_ja": {
          "type": "string",
          "minLength": 1
        },
        "official_label_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "description_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_ja",
        "validity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name_ja": {
          "type": "string",
          "minLength": 1
        },
        "official_label_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "validity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "calendar_day",
                "consecutive_days",
                "selectable_days",
                "hours_from_first_use",
                "hours_pool",
                "fixed_time_window",
                "points",
                "rides",
                "unknown"
              ]
            },
            "hours": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "days": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "points": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "rides": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "start_time": {
              "anyOf": [
                {
                  "$ref": "#/$defs/timeOfDay"
                },
                {
                  "type": "null"
                }
              ]
            },
            "end_time": {
              "anyOf": [
                {
                  "$ref": "#/$defs/timeOfDay"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes_ja": {
              "type": [
                "string",
                "null"
              ]
            },
            "usable_within": {
              "description": "分割可能な複数日券の有効範囲。「シーズン中の任意5日」と「購入から30日以内の任意3日」は別物なので区別する。",
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "season",
                        "days_from_purchase",
                        "days_from_first_use",
                        "date_range",
                        "unknown"
                      ]
                    },
                    "value": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "start": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/date"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "end": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/date"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "official_text_ja": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "area_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "included_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name_ja"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "lunch",
                  "meal_voucher",
                  "drink",
                  "onsen",
                  "spa",
                  "rental",
                  "lesson",
                  "gondola_sightseeing",
                  "parking",
                  "coupon_voucher",
                  "unknown"
                ]
              },
              "name_ja": {
                "type": "string",
                "minLength": 1
              },
              "official_label_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "description_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value_amount": {
                "$ref": "#/$defs/nullableAmount"
              },
              "notes_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_refs": {
                "$ref": "#/$defs/sourceRefs"
              }
            }
          }
        },
        "shared_with_resorts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name_ja"
            ],
            "properties": {
              "resort_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name_ja": {
                "type": "string",
                "minLength": 1
              },
              "official_label_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_refs": {
                "$ref": "#/$defs/sourceRefs"
              }
            }
          }
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "covers_hours_types": {
          "description": "この券が使える営業区分。**1日券・複数日券にのみ設定する**（券自体に時間が書かれていないため、ナイターを含むかが validity から導出できない）。時間券は validity の時間帯・時間数から判定できるので設定しない。資料に記載が無い場合は null（推測しない）。",
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "regular",
                  "night",
                  "early_morning",
                  "special"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "purchaseDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "days_before_use": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "time_of_day": {
          "anyOf": [
            {
              "$ref": "#/$defs/timeOfDay"
