    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "enum": [
            "JPY"
          ]
        },
        "amount": {
          "$ref": "#/$defs/nullableAmount"
        },
        "date_table": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dateTableRow"
          }
        },
        "base_offer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "discount": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "amount",
                "percent"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "range": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/nonNegativeAmount"
            },
            "max": {
              "$ref": "#/$defs/nonNegativeAmount"
            }
          }
        },
        "live_lookup_required": {
          "type": "boolean"
        },
        "live_lookup_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "observed_amount": {
          "$ref": "#/$defs/nullableAmount"
        },
        "notes_ja": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "fixed"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "$ref": "#/$defs/nonNegativeAmount"
              }
            },
            "required": [
              "amount"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "date_table"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "date_table": {
                "type": "array",
                "minItems": 1
              }
            },
            "required": [
              "date_table"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live_dynamic"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "type": "null"
              },
              "live_lookup_required": {
                "const": true
              }
            },
            "required": [
              "live_lookup_required"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "range"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "range": {
                "type": "object"
              }
            },
            "required": [
              "range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "derived_discount"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "base_offer_id": {
                "type": "string"
              },
              "discount": {
                "type": "object"
              }
            },
            "required": [
              "base_offer_id",
              "discount"
            ]
          }
        }
      ]
    },
