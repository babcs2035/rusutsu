{
  "name": "rusutsu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check --write src",
    "format": "biome format --write src",
    "check": "biome check src && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@chakra-ui/react": "^3",
    "@emotion/react": "^11",
    "@next/third-parties": "^16.1.6",
    "@prisma/adapter-pg": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.26",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.500",
    "next": "^16.1",
    "node-cron": "^4.2.1",
    "pg": "^8.17.2",
    "playwright": "^1.58.0",
    "react": "^19.2",
    "react-dom": "^19.2",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "5.0.0-rc.0",
    "recharts": "^3.5.1",
    "ts-tqdm": "^0.8.6",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-leaflet": "^3.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prisma": "^6.19.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{ts,tsx}": [
      "bash -c 'tsc --noEmit'"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.2"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@tailwindcss/oxide",
      "sharp"
    ]
  },
  "prisma": {
    "seed": "pnpx tsx prisma/seed.ts"
  }
}
