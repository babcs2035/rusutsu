{
  "name": "rusutsu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm maplibre:worker && next dev --hostname 127.0.0.1",
    "dev:lan": "pnpm maplibre:worker && next dev --hostname 0.0.0.0",
    "build": "pnpm maplibre:worker && next build",
    "postbuild": "mkdir -p .next/standalone/public && cp -r public/. .next/standalone/public/ && cp -r .next/static/. .next/standalone/.next/static/",
    "start": "next start",
    "format": "biome format --write src scripts",
    "lint": "biome check --write src scripts",
    "typecheck": "pnpm tsc --noEmit",
    "test": "node scripts/runTests.mjs",
    "prepare": "husky",
    "maplibre:worker": "node scripts/copyMaplibreWorker.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@next/third-parties": "^16.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/config": "^7.9.1",
    "@radix-ui/react-portal": "^1.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.5.0",
    "next": "^16.3.0",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "5.0.0-rc.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ts-tqdm": "^0.8.6",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@prisma/config": "^7.9.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
