# Docker Composeがホストへ公開するアプリのポート。
# Next.jsをホストで起動する際のPORTは.envから読まれないため、通常は3000のまま使う。
APP_PORT=3000
DB_PORT=5432
DATABASE_URL="postgresql://rusutsu:rusutsu@localhost:5432/rusutsu"

# Auth.js
AUTH_SECRET="your-random-secret-change-in-production"
# Origin only. Do not append the Next.js base path (/rusutsu).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Initial admin users (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# Internal data API (server-to-server only; never use a NEXT_PUBLIC_ prefix)
# Local-only setupでは空のままでよい。本番ではopenssl rand -hex 32を3回実行し、
# 必ず異なる値を設定する。本番の新規設定はGitHub Actionsの同名Secretsへ登録する。
# Local Next.js/admin operations. Never give this token to a crawler worker.
INTERNAL_DATA_API_ADMIN_TOKEN=""
# crawl_latest result and failure-DOM ingestion only.
INTERNAL_DATA_API_CRAWLER_TOKEN=""
# Diagnostic run metadata and failure-DOM downloads only.
INTERNAL_DATA_API_DIAGNOSTICS_TOKEN=""

# API client destination. Leave empty for ordinary local JSON output. The
# production crawl_latest scheduler requires the public HTTPS URL including
# the Next.js base path, for example: https://example.com/rusutsu
DATA_API_BASE_URL=""

# crawl_latest scheduler (production default: every day at 07:00 JST).
CRAWL_LATEST_CRON="0 7 * * *"
CRAWL_LATEST_CONCURRENCY=1
# Per-resort timeout in milliseconds (20 minutes).
CRAWL_LATEST_TIMEOUT_MS=1200000

# Failure/warning DOMs are kept outside the replaceable application container.
CRAWLER_ARTIFACT_ROOT="./var/crawler-artifacts"
# Keep warning/failure DOM for 30 days (1-3650); DB run/issues/hashes remain.
CRAWLER_ARTIFACT_RETENTION_DAYS=30

# Google Maps (for edit pages)
# This value is sent to the browser; restrict allowed referrers in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Production only: use the existing PostgreSQL volume credentials.
POSTGRES_USER=rusutsu
POSTGRES_PASSWORD=rusutsu
POSTGRES_DB=rusutsu
# Local/manual Compose only. Production deploy is controlled through GitHub
# repository variable ENABLE_CRAWL_LATEST_SCHEDULER=true after staged checks.
COMPOSE_PROFILES=""
# Production deployment automatically recovers these from the running containers.
# Do not paste a production DB URL into your local environment.
# PRODUCTION_DATABASE_URL and POSTGRES_VOLUME are generated on the VPS.
# Backups stay on that VPS in the SSH user's ~/.local/state/rusutsu/<project>/.
# No external storage credentials or backup encryption keys are required.
