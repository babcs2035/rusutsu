# ローカル開発用の設定．mise run setup はこのファイルを .env にコピーする．

# 開発 DB．Docker Compose の DB 公開ポートを変える場合は URL のポートも合わせる．
DB_PORT=5432
DATABASE_URL="postgresql://rusutsu:rusutsu@localhost:5432/rusutsu"

# ホスト上の開発サーバーのポートは mise run dev -- --port 3001 のように指定する．
# アプリも Docker Compose で動かす場合は，必要に応じて公開ポートを指定する．
# APP_PORT=3000

# 正本データ API．API_BASE_URL が空の場合，開発サーバーはローカル DB を使う．
# 接続先は .env.local で上書きできる (例 https://example.com/rusutsu)．
# 接続先はこのブランチの API に対応する版を使う．トークンはサーバー側だけで扱う．
API_BASE_URL=""
API_BEARER_TOKEN=""

# Auth.js．AUTH_URL はオリジンのみを指定し，開発サーバーのポートに合わせる．
AUTH_SECRET="your-random-secret-change-in-production"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Google OAuth と初期管理者．複数の管理者はメールアドレスをカンマで区切る．
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
ADMIN_EMAILS="admin@example.com"

# 編集画面の Google Maps 用．ブラウザーに公開されるため，許可する参照元を制限する．
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# 本番配備の設定は docs/d0005_backend-migration-runbook.md を参照する．
