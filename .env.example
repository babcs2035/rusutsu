PORT=3000
DB_PORT=5432
DATABASE_URL="postgresql://rusutsu:rusutsu@localhost:5432/rusutsu"

# Auth.js
AUTH_SECRET="your-random-secret-change-in-production"

# Base URL origin for Auth.js — origin only.
# The route handler patches the pathname to include /rusutsu.
AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Initial admin users (comma-separated emails)
ADMIN_EMAILS="admin@example.com"

# Google Maps (for edit pages)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
